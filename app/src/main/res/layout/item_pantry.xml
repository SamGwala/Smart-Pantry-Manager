<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="6dp"
    app:cardBackgroundColor="@color/colorCard"
    app:cardCornerRadius="4dp"
    app:cardElevation="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Perforated-ticket top edge: the "Pantry Ledger" motif -->
        <View
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:background="@drawable/divider_dashed" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:id="@+id/textIngredientName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/work_sans_family"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="@color/colorTextPrimary"
                tools:text="Tomato" />

            <TextView
                android:id="@+id/textIngredientQuantity"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/plex_mono_family"
                android:textSize="14sp"
                android:textColor="@color/colorAccent"
                tools:text="4 pcs" />

            <TextView
                android:id="@+id/textIngredientExpiry"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/work_sans_family"
                android:textSize="12sp"
                android:textColor="@color/colorTextSecondary"
                tools:text="Expires: 2026-09-20" />

        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>
